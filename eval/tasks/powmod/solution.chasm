fn powmod(base: Int, exponent: Int, modulus: Int) -> Int {
    let result = 1 % modulus
    let b = base % modulus
    let e = exponent
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % modulus
        }
        b = b * b % modulus
        e = e / 2
    }
    return result
}

fn main() {
    print(powmod(2, 10, 1000))
    print(powmod(3, 200, 40009))
    print(powmod(7, 123456, 30011))
    print(powmod(10, 0, 7))
}
