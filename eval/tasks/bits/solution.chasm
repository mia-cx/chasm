fn ones(value: Int) -> Int {
    let n = value
    let count = 0
    while n > 0 {
        count = count + n % 2
        n = n / 2
    }
    return count
}

fn bitLength(value: Int) -> Int {
    let n = value
    let length = 0
    while n > 0 {
        length = length + 1
        n = n / 2
    }
    return length
}

fn show(n: Int) {
    print(ones(n))
    print(bitLength(n))
}

fn main() {
    show(1)
    show(12)
    show(255)
    show(1024)
    show(2147483647)
}
